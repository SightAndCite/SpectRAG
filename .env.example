# Copy this file to `.env` and fill in your values.
#
# These are only needed in the DEFAULT configuration, which uses OpenAI
# `gpt-4o-mini` for index-time concept extraction, utility-question generation,
# and answer generation. To run fully local with no API key, set
# `entity_extraction_mode="ner"` and `utility_question_llm_backend="ollama"`
# in config.py (see the README "Configuration" section).

# Your OpenAI API key — required for the default OpenAI mode.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the OpenAI base URL (e.g. an OpenAI-compatible proxy or
# Azure endpoint). Leave commented to use the default https://api.openai.com/v1.
# OPENAI_BASE_URL=https://api.openai.com/v1
